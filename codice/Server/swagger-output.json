    "/caricaGeneri": {
      "get": {
        "description": "restituisce i generi musicali",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/registrazione": {
      "post": {
        "description": "inserisce un nuovo utente nel database",
        "parameters": [
          {
            "name": "data",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "nomeUtente": {
                  "example": "Sir"
                },
                "password": {
                  "example": "password"
                },
                "email": {
                  "example": "luca.salvadori@example.it"
                },
                "nome": {
                  "example": "Luca"
                },
                "cognome": {
                  "example": "Salvadori"
                },
                "sesso": {
                  "example": "M"
                },
                "dataNascita": {
                  "example": "1998-01-01"
                },
                "generi": {
                  "example": ["Rock", "Pop"]
                },
                "artistaPreferito": {
                  "example": "Queen"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Documento creato"
          },
          "400": {
            "description": "Dati non validi (uno o più)"
          },
          "500": {
            "description": "Errore del database"
          }
        }
      }
    },
    "/login": {
      "post": {
        "description": "effettua il login",
        "parameters": [
          {
            "name": "data",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "example": "luca.salvadori@example.it"
                },
                "password": {
                  "example": "password"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login effettuato"
          },
          "400": {
            "description": "Dati non validi"
          },
          "401": {
            "description": "Credenziali non valide"
          },
          "500": {
            "description": "Errore del database"
          }
        }
      }
    },
    "/user/password": {
      "post": {
        "description": "modifica la password dell'utente",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "data",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "example": "df2s4s6rty889dsce53sde45"
                },
                "oldPassword": {
                  "example": "password"
                },
                "newPassword": {
                  "example": "newPassword"
                }
              }
            }
          }
        ],
        "responses": {
          "200":{ 
            "description": "Password modificata"
          },
          "400": {
            "description": "Dati non validi"
          },
          "401": {
            "description": "Non autorizzato"
          },
          "403": {
            "description": "Non autorizzato a modificare la password"
          },
          "404" : {
            "description": "Utente non trovato o password non corretta"
          },
          "500": {
            "description": "Errore del database"
          }
        }
      }
    },
    "/logout": {
      "post": {
